<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <ReactiveFallback>
      <Sequence name="ParkApprovedPoint">
        <FarSideGuard command="has_approved"/>
        <WeltModelNode goal_pose="{approved_point}" state="{state}"/>
        <WaitForCarsGone idle_timeout="15" max_wait="60"/>
      </Sequence>

      <!-- 保存首次找到的远侧点，只等待车辆条件；放行后直接使用该点。 -->
      <Sequence name="WaitForFarSideClear">
        <FarSideGuard command="has_far_pending"/>
        <WaitForFarSide clear_sec="3" busy_sec="4" max_wait="15" stale_sec="1.0" topic_name="/car_information_all"/>
        <FarSideGuard command="approve"/>
        <FarSideGuard command="yield"/>
      </Sequence>

      <Sequence name="InitialSearch">
        <Inverter>
          <FarSideGuard command="skip_initial"/>
        </Inverter>
        <RateController hz="1.0">
          <FindCarAvoidancePoint polygons="{polygons}" car_pose="{car_pose}" car_size="{car_size}" enable_far_side="{allow_far}" free_point="{free_point}" goal="{goal}" candidate_point="{candidate_point}" point_side="{point_side}" state="{state}"/>
        </RateController>
        <Fallback>
          <Sequence>
            <FarSideGuard command="is_near_or_external"/>
            <FarSideGuard command="approve"/>
            <FarSideGuard command="yield"/>
          </Sequence>
          <Sequence>
            <FarSideGuard command="is_far"/>
            <FarSideGuard command="yield"/>
          </Sequence>
        </Fallback>
      </Sequence>

      <Sequence name="RightEdge">
        <FarSideGuard command="commit"/>
        <PipelineSequence>
          <RateController hz="1.0">
            <Inverter>
              <Sequence>
                <FarSideGuard command="refresh"/>
                <FindCarAvoidancePoint polygons="{polygons}" car_pose="{car_pose}" car_size="{car_size}" enable_far_side="{allow_far}" free_point="{free_point}" goal="{goal}" candidate_point="{candidate_point}" point_side="{point_side}" state="{state}"/>
                <Fallback>
                  <Sequence>
                    <FarSideGuard command="is_near_or_external"/>
                    <FarSideGuard command="approve"/>
                  </Sequence>
                  <FarSideGuard command="is_far"/>
                </Fallback>
              </Sequence>
            </Inverter>
          </RateController>
          <RunOnce>
            <ComputeRightEdgePath polygons="{polygons}" car_pose="{car_pose}" garage_path="{garage_path}" goals="{goals}" state="{state}"/>
          </RunOnce>
          <SubTree ID="NavigateThroughPoses" __shared_blackboard="true"/>
        </PipelineSequence>
      </Sequence>

      <FarSideGuard command="hold_if_point"/>
    </ReactiveFallback>
  </BehaviorTree>

  <BehaviorTree ID="NavigateThroughPoses">
    <RecoveryNode number_of_retries="12" name="NavigateRecovery">
      <PipelineSequence name="NavigateWithReplanning">
        <RateController hz="1.0">
          <IsPedestrianFront pedestrain_distance = "2.0"/>
        </RateController>
        <RateController hz="5.0">
          <IsCollision/>
        </RateController>
        <RateController hz="10.0">
          <RemovePassedGoals input_goals="{goals}" output_goals="{goals}" radius="1.0"/>
        </RateController>
        <RunOnce>
          <RecoveryNode number_of_retries="2" name="ComputePathThroughPoses">
            <Sequence>
              <ClearCostmapExceptRegion name="ClearGlobalCostmap-Context" service_name="global_costmap/clear_except_global_costmap" reset_distance="2.0"/>
              <Wait wait_duration="0.5"/>
              <IsPathValid goals="{goals}" check_distance="10000.0"/>
              <ComputePathThroughPoses goals="{goals}" path="{path}" planner_id="GridBased"/>
            </Sequence>
            <Sequence>
              <Wait wait_duration="0.5"/>
              <ClearCostmapExceptRegion name="ClearGlobalCostmap-Context" service_name="global_costmap/clear_except_global_costmap" reset_distance="2.0"/>
              <Wait wait_duration="0.5"/>
              <Fallback>
                <IsPathValid goals="{goals}" check_distance="10000.0"/>
                <PathCheck check_distance="10000.0"/>
              </Fallback>
              <Wait wait_duration="0.5"/>
            </Sequence>
          </RecoveryNode>
        </RunOnce>
        <!-- 5 秒远侧屏蔽从开始跟踪靠右路径起算，同一次靠右只记一次。 -->
        <FarSideGuard command="arm_tracking" suppress_sec="5"/>
        <RecoveryNode number_of_retries="2" name="FollowPath">
          <FollowPath path="{path}" controller_id="FollowPath"/>
          <Sequence>
            <ClearCostmapExceptRegion name="ClearGlobalCostmap-Context" service_name="local_costmap/clear_except_local_costmap" reset_distance="2.0"/>
            <ClearCostmapExceptRegion name="ClearGlobalCostmap-Context" service_name="global_costmap/clear_except_global_costmap" reset_distance="2.0"/>
            <Wait wait_duration="0.5"/>
            <ComputePathThroughPoses goals="{goals}" path="{path}" planner_id="GridBased"/>
          </Sequence>
        </RecoveryNode>
      </PipelineSequence>
      <ReactiveFallback name="RecoveryFallback">
        <GoalUpdated/>
        <Sequence name="RecoveryActions">
          <Wait wait_duration="0.5"/>
          <ClearCostmapExceptRegion name="ClearGlobalCostmap-Context" service_name="local_costmap/clear_except_local_costmap" reset_distance="2.0"/>
          <ClearCostmapExceptRegion name="ClearGlobalCostmap-Context" service_name="global_costmap/clear_except_global_costmap" reset_distance="2.0"/>
          <Wait wait_duration="0.5"/>
          <Fallback>
            <IsCollision/>
            <CollisionRecover/>
          </Fallback>
          <Wait wait_duration="0.5"/>
        </Sequence>
      </ReactiveFallback>
    </RecoveryNode>
  </BehaviorTree>
</root>
