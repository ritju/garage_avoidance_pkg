<?xml version="1.0"?>
<!--
  For instructions on using Groot and description of the following BehaviorTree nodes,
  please refer to the groot_instructions.md and REAMDE.md respectively located in the
  nav2_behavior_tree package.
-->
<root>
  <TreeNodesModel>
    <Decorator ID="StopWhenCarsGone">
      <input_port name="idle_timeout" default="3.0">连续未收到非空动车消息的退出时间（秒）</input_port>
      <input_port name="topic_name" default="/car_information">动车信息话题</input_port>
    </Decorator>
    <!-- ############################### ACTION NODES ################################# -->  

    <Action ID="ComputeRightEdgePath">
      <input_port name="goal">The goal to send</input_port>
      <input_port name="server_name">Server name</input_port>
      <input_port name="server_timeout">Server timeout</input_port>
      <output_port name="path">Path created by ComputeRightEdgePath node</output_port>
    </Action>
  </TreeNodesModel>
</root>
